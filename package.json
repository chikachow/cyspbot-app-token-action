{
  "name": "cyspbot-app-token-action",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action for obtaining a short-lived repository-scoped app installation token from cyspbot.",
  "type": "module",
  "scripts": {
    "bundle": "node --run clean && tsdown",
    "check": "node --run pnpm:check && node --run lockfile:check && node --run peer-dependencies:check && node --run dedupe:check && node --run format:check && node --run lint && node --run typecheck && node --run test && node --run bundle",
    "clean": "rm -rf dist",
    "dedupe:check": "pnpm dedupe --check --ignore-scripts",
    "format": "oxfmt . '!dist'",
    "format:check": "oxfmt --check . '!dist'",
    "lint": "oxlint --type-aware --report-unused-disable-directives --ignore-pattern dist .",
    "lint:fix": "oxlint --type-aware --fix --ignore-pattern dist .",
    "lockfile:check": "pnpm install --lockfile-only --frozen-lockfile",
    "peer-dependencies:check": "pnpm peers check",
    "pnpm:check": "node scripts/check-pnpm.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/recommended": "1.0.13",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.15.0"
}
